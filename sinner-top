@dataclass(frozen=True)
class Allocation:
    node: str
    gpu_type: str
    count: int
    indices: str


@dataclass(frozen=True)
class NodeInventory:
    name: str
    state: str
    total: dict[str, int]
    allocated: dict[str, int]

    def free(self, gpu: str) -> int:
        return max(0, self.total.get(gpu, 0) - self.allocated.get(gpu, 0))

    def idle(self, gpu: str) -> int:
        return self.free(gpu) if _node_is_schedulable(self.state) else 0


