class SlurmCommandError(RuntimeError):
    """Raised when a Slurm query fails."""


def _run(command: Sequence[str]) -> str:
    try:
        result = subprocess.run(
            command,
            check=True,
            capture_output=True,
            text=True,
            timeout=10,
        )
    except subprocess.TimeoutExpired as error:
        raise SlurmCommandError(f"{command[0]} timed out after 10 seconds") from error
    except FileNotFoundError as error:
        raise SlurmCommandError(f"command not found: {command[0]}") from error
    except subprocess.CalledProcessError as error:
        detail = error.stderr.strip() or error.stdout.strip() or "unknown error"
        raise SlurmCommandError(f"{' '.join(command)} failed: {detail}") from error
    return result.stdout


def parse_squeue(output: str) -> list[Job]:
    jobs: list[Job] = []
    for line in output.splitlines():
        if not line.strip():
            continue
        fields = line.split("|")
        if len(fields) not in {8, 9, 10}:
            raise ValueError(f"unexpected squeue row: {line!r}")
        jobs.append(Job(*fields))
    return jobs


def _typed_tres(tres: str) -> dict[str, int]:
    result: dict[str, int] = {}
    for gpu_type, count in re.findall(
        r"(?:^|,)gres/gpu:([^,=]+)=(\d+)(?=,|$)", tres.lower()
    ):
        result[gpu_type] = int(count)
    generic = re.search(r"(?:^|,)gres/gpu=(\d+)(?=,|$)", tres)
    if generic:
        untyped = int(generic.group(1)) - sum(result.values())
        if untyped > 0:
            result["any"] = untyped
    return result


def _ordered_gpu_types(gpu_types) -> list[str]:
    return sorted(set(gpu_types), key=lambda gpu: (
        PREFERRED_GPU_TYPES.index(gpu) if gpu in PREFERRED_GPU_TYPES else 2,
        gpu == "any", gpu,
    ))


def _node_is_schedulable(state: str) -> bool:
    upper = state.upper()
    if upper.endswith("*") or upper.endswith("~") or upper.endswith("#"):
        return False
    return not any(flag in upper for flag in UNSCHEDULABLE_STATES)


def parse_gpu_nodes(output: str) -> list[NodeInventory]:
    nodes = []
    for line in output.splitlines():
        if not line.strip():
            continue
        state_match = re.search(r"(?:^|\s)State=(\S+)", line)
        configured_match = re.search(r"(?:^|\s)CfgTRES=(\S+)", line)
        allocated_match = re.search(r"(?:^|\s)AllocTRES=(\S*)", line)
        if state_match is None or configured_match is None:
            continue
        configured = _typed_tres(configured_match.group(1))
        allocated = _typed_tres(
            allocated_match.group(1) if allocated_match is not None else ""
        )
        # An untyped allocation is unambiguous on a single-type GPU node.
        if len(configured) == 1 and "any" not in configured and "any" in allocated:
            gpu = next(iter(configured))
            allocated[gpu] = allocated.get(gpu, 0) + allocated.pop("any")
        name_match = re.search(r"(?:^|\s)NodeName=(\S+)", line)
        nodes.append(NodeInventory(
            name_match.group(1) if name_match else "?",
            state_match.group(1), configured, allocated,
        ))
    return nodes


def _gpu_inventory(
    nodes: Sequence[NodeInventory],
) -> tuple[dict[str, int], dict[str, int], dict[str, int]]:
    idle: dict[str, int] = {}
    active: dict[str, int] = {}
    total: dict[str, int] = {}
    for node in nodes:
        for gpu_type, count in node.total.items():
            total[gpu_type] = total.get(gpu_type, 0) + count
            idle.setdefault(gpu_type, 0)
            active.setdefault(gpu_type, 0)
            if _node_is_schedulable(node.state):
                active[gpu_type] += count
                idle[gpu_type] += node.free(gpu_type)
    return idle, active, total


def parse_gpu_inventory(
    output: str,
) -> tuple[dict[str, int], dict[str, int], dict[str, int]]:
    """Return idle, active, and configured totals by GPU type."""
    return _gpu_inventory(parse_gpu_nodes(output))


def parse_idle_gpus(output: str) -> dict[str, int]:
    return parse_gpu_inventory(output)[0]


def _expand_number_list(value: str) -> list[str]:
    values: list[str] = []
    for part in value.split(","):
        if "-" not in part:
            values.append(part)
            continue
        start_text, end_text = part.split("-", 1)
        start = int(start_text)
        end = int(end_text)
        width = max(len(start_text), len(end_text))
        values.extend(f"{number:0{width}d}" for number in range(start, end + 1))
    return values


def expand_nodelist(value: str) -> list[str]:
    """Expand common Slurm bracket ranges without starting another process."""

    # Split commas between hosts before expanding commas inside brackets.
    depth = 0
    for index, char in enumerate(value):
        if char == "[":
            depth += 1
        elif char == "]":
            depth -= 1
        elif char == "," and depth == 0:
            return expand_nodelist(value[:index]) + expand_nodelist(value[index + 1:])
    match = re.search(r"\[([^][]+)\]", value)
    if match is None:
        return [value]
    prefix = value[: match.start()]
    suffix = value[match.end() :]
    expanded: list[str] = []
    for number in _expand_number_list(match.group(1)):
        expanded.extend(expand_nodelist(f"{prefix}{number}{suffix}"))
    return expanded


def _effective_job_id(header: str) -> str:
    base_match = re.search(r"^JobId=(\S+)", header)
    if base_match is None:
        raise ValueError(f"missing JobId in {header!r}")
    task_match = re.search(r"(?:^|\s)ArrayTaskId=(\S+)", header)
    if task_match is None:
        return base_match.group(1)
    # Slurm gives a running array element its own internal JobId while squeue
    # displays <ArrayJobId>_<ArrayTaskId>.  Join on the user-facing identifier.
    array_match = re.search(r"(?:^|\s)ArrayJobId=(\S+)", header)
    array_job_id = array_match.group(1) if array_match else base_match.group(1)
    return f"{array_job_id}_{task_match.group(1)}"


def parse_job_allocations(output: str) -> dict[str, list[Allocation]]:
    allocations: dict[str, list[Allocation]] = {}
    current_job: str | None = None
    gpu_pattern = re.compile(
        r"gpu(?::(?P<type>[^:,()]+))?:(?P<count>\d+)"
        r"\(IDX:(?P<indices>[^)]+)\)",
        re.IGNORECASE,
    )
    for raw_line in output.splitlines():
        line = raw_line.strip()
        if line.startswith("JobId="):
            current_job = _effective_job_id(line)
            allocations.setdefault(current_job, [])
            continue
        if current_job is None or not line.startswith("Nodes=") or " GRES=" not in line:
            continue
        node_match = re.match(r"Nodes=(\S+)", line)
        gres_match = re.search(r"(?:^|\s)GRES=(\S+)", line)
        if node_match is None or gres_match is None:
            continue
        nodes = expand_nodelist(node_match.group(1))
        for match in gpu_pattern.finditer(gres_match.group(1)):
            gpu_type = (match.group("type") or "any").lower()
            count = int(match.group("count"))
            if count == 0:
                continue
            indices = match.group("indices")
            for node in nodes:
                allocations[current_job].append(
                    Allocation(node, gpu_type, count, indices)
                )
    return allocations


def _fallback_allocations(job: Job) -> list[Allocation]:
    matches = re.finditer(
        r"(?:^|,)(?:gres/)?gpu(?::(?P<type>[^:,()]+))?:(?P<count>\d+)",
        job.gres,
        re.IGNORECASE,
    )
    return [
        Allocation(job.node_list or "?", (match.group("type") or "any").lower(), int(match.group("count")), "?")
        for match in matches if int(match.group("count")) > 0
    ]


def collect_snapshot() -> Snapshot:
    queue = _run(
        (
            "squeue",
            "--array",
            "--noheader",
            "--states=RUNNING,COMPLETING,PENDING",
            "--format=%i|%u|%j|%N|%b|%L|%e|%T|%S|%a",
        )
    )
    nodes = _run(("scontrol", "show", "nodes", "--oneliner"))
    details = _run(("scontrol", "show", "jobs", "--details"))
    inventory = parse_gpu_nodes(nodes)
    idle, active, total = _gpu_inventory(inventory)
    return Snapshot(
        idle=idle,
        active=active,
        total=total,
        jobs=parse_squeue(queue),
        allocations=parse_job_allocations(details),
        nodes=inventory,
    )


def _remaining_seconds(value: str) -> float:
    if not re.fullmatch(r"(?:\d+-)?\d+:\d+(?::\d+)?", value):
        return float("inf")
    day_count = 0
    clock = value
    if "-" in value:
        days, clock = value.split("-", 1)
        day_count = int(days)
    fields = [int(field) for field in clock.split(":")]
    if len(fields) == 3:
        hours, minutes, seconds = fields
    elif len(fields) == 2:
        hours = 0
        minutes, seconds = fields
    else:
        return float("inf")
    return day_count * 86400 + hours * 3600 + minutes * 60 + seconds


def _remaining_label(value: str) -> str:
    return _duration_label(_remaining_seconds(value))


def _duration_label(seconds: float) -> str:
    if seconds == float("inf"):
        return "unknown"
    total_minutes = int(seconds) // 60
    if total_minutes == 0:
        return "<1m"
    hours, minutes = divmod(total_minutes, 60)
    if hours:
        return f"{hours}h {minutes:02d}m"
    return f"{minutes}m"


def _timestamp(value: str) -> float:
    try:
        return datetime.fromisoformat(value).timestamp()
    except (ValueError, OverflowError, OSError):
        return float("inf")


def _finish_key(job: Job, now: float) -> tuple[float, float, str, tuple[int, ...]]:
    remaining = _remaining_seconds(job.left)
    end = _timestamp(job.end)
    if end == float("inf"):
        if job.state.upper() in QUEUED_STATES:
            end = _timestamp(job.start) + remaining
        else:
            end = now + remaining
    # Jobs without a finish estimate follow known finishes, shortest limit first.
    return end, remaining, job.name, tuple(map(int, re.findall(r"\d+", job.job_id)))


def _start_label(value: str, now: float) -> str:
    start = _timestamp(value)
    if start == float("inf"):
        return "start unknown"
    if start < now:
        return "start overdue"
    return f"start in ~{_duration_label(start - now)}"


def _style(text: str, *codes: str, color: bool) -> str:
    if not color:
        return text
    return f"\033[{';'.join(codes)}m{text}\033[0m"


def _display_width(text: str) -> int:
    return sum(
        0 if unicodedata.combining(char) or unicodedata.category(char) == "Cf"
        else 2 if unicodedata.east_asian_width(char) in {"W", "F"}
        else 1
        for char in ANSI_PATTERN.sub("", text)
    )


def _wrap_line(line: str, width: int) -> list[str]:
    """Wrap at spaces while preserving ANSI styles and wide-character alignment."""
    characters: list[tuple[str, str]] = []
    active_style = ""
    for token in re.findall(r"\x1b\[[0-9;]*m|[^\x1b]", line):
        if ANSI_PATTERN.fullmatch(token):
            active_style = "" if token == "\033[0m" else token
        else:
            characters.append((token, active_style))
    wrapped: list[str] = []
    indent = ""
    while characters:
        used = len(indent)
        end = 0
        last_space = 0
        content_seen = False
        for char, _ in characters:
            char_width = _display_width(char)
            if used + char_width > width:
                break
            used += char_width
            end += 1
            if char == " " and content_seen:
                last_space = end
            elif char != " ":
                content_seen = True
        if end < len(characters) and last_space:
            next_word = []
            for char, _ in characters[last_space:]:
                if char == " ":
                    break
                next_word.append(char)
            # Split a word that cannot fit on a continuation line in place,
            # rather than leaving a tree branch by itself on the previous line.
            if _display_width("".join(next_word)) <= width - min(5, width // 4):
                end = last_space
        end = max(end, 1)
        fragment = characters[:end]
        while fragment and fragment[-1][0] == " ":
            fragment.pop()
        parts = [indent]
        active_style = ""
        for char, style in fragment:
            if style != active_style:
                if active_style:
                    parts.append("\033[0m")
                if style:
                    parts.append(style)
                active_style = style
            parts.append(char)
        if active_style:
            parts.append("\033[0m")
        wrapped.append("".join(parts))
        characters = characters[end:]
        while characters and characters[0][0] == " ":
            characters.pop(0)
        indent = " " * min(5, width // 4)
    return wrapped or [""]


def _side_by_side(left: list[str], right: list[str], width: int) -> list[str]:
    left_width = (width - 3) // 2
    right_width = width - 3 - left_width
    left_lines = [part for line in left for part in _wrap_line(line, left_width)]
    right_lines = [part for line in right for part in _wrap_line(line, right_width)]
    return [
        f"{a}{' ' * (left_width - _display_width(a))} │ {b}".rstrip()
        for a, b in zip_longest(left_lines, right_lines, fillvalue="")
    ]


def _remaining_color(value: str) -> str:
    return _duration_color(_remaining_seconds(value))


def _duration_color(seconds: float) -> str:
    if seconds <= 3600:
        return "32"
    if seconds <= 6 * 3600:
        return "33"
    if seconds < float("inf"):
        return "31"
    return "2"


def _gpu_usage(allocations: Sequence[Allocation]) -> dict[str, int]:
    usage: dict[str, int] = {}
    for allocation in allocations:
        usage[allocation.gpu_type] = usage.get(allocation.gpu_type, 0) + allocation.count
    return usage


def _usage_label(usage: dict[str, int]) -> str:
    parts = [
        f"{usage[gpu_type]}×{gpu_type.upper()}"
        for gpu_type in _ordered_gpu_types(usage)
        if usage[gpu_type]
    ]
    return ", ".join(parts) or "0×GPU"


def _available_gpu_types(snapshot: Snapshot) -> list[str]:
    types = set(snapshot.total)
    for job in snapshot.jobs:
        allocations = snapshot.allocations.get(job.job_id) or _fallback_allocations(job)
        types.update(a.gpu_type for a in allocations if a.count)
    return _ordered_gpu_types(types) or ["h200"]


def _gpu_shortcuts(gpu_types: Sequence[str]) -> dict[str, str]:
    shortcuts = {key: gpu for key, gpu in (("1", "h100"), ("2", "h200")) if gpu in gpu_types}
    for key, gpu in zip("3456789", (gpu for gpu in gpu_types if gpu not in PREFERRED_GPU_TYPES)):
        shortcuts[key] = gpu
    return shortcuts


def _id_label(allocations: Sequence[Allocation]) -> str:
    return ", ".join(
        f"{allocation.node}:{allocation.gpu_type.upper()}[{allocation.indices}]"
        for allocation in allocations
    )


def _group_jobs(
    snapshot: Snapshot, states: set[str], gpu_type: str | None = None
) -> list[
    tuple[
        int,
        str,
        dict[str, int],
        list[tuple[Job, list[Allocation], dict[str, int]]],
    ]
]:
    grouped: dict[str, list[tuple[Job, list[Allocation], dict[str, int]]]] = {}
    for job in snapshot.jobs:
        if job.state.upper() not in states:
            continue
        job_allocations = snapshot.allocations.get(job.job_id) or _fallback_allocations(
            job
        )
        if gpu_type is not None:
            job_allocations = [a for a in job_allocations if a.gpu_type == gpu_type]
        usage = _gpu_usage(job_allocations)
        if sum(usage.values()) == 0:
            continue
        grouped.setdefault(job.user, []).append((job, job_allocations, usage))

    user_rows: list[
        tuple[
            int,
            str,
            dict[str, int],
            list[tuple[Job, list[Allocation], dict[str, int]]],
        ]
    ] = []
    for user, jobs in grouped.items():
        total: dict[str, int] = {}
        for _, _, usage in jobs:
            for gpu, count in usage.items():
                total[gpu] = total.get(gpu, 0) + count
        user_rows.append((sum(total.values()), user, total, jobs))
    user_rows.sort(key=lambda row: (-row[0], row[1]))
    return user_rows


def _account_rankings(snapshot: Snapshot) -> list[AccountUsage]:
    grouped: dict[str, dict[str, dict[str, int]]] = {}
    for _, user, _, jobs in _group_jobs(snapshot, RUNNING_STATES):
        for job, _, usage in jobs:
            account = job.account.strip()
            if account in {"", "N/A", "(null)"}:
                account = "unknown"
            user_usage = grouped.setdefault(account, {}).setdefault(user, {})
            for gpu, count in usage.items():
                user_usage[gpu] = user_usage.get(gpu, 0) + count
    return _rank_accounts(grouped)


def _rank_accounts(grouped: dict[str, dict[str, dict[str, int]]]) -> list[AccountUsage]:
    rankings: list[AccountUsage] = []
    for account, users in grouped.items():
        total: dict[str, int] = {}
        for usage in users.values():
            for gpu, count in usage.items():
                total[gpu] = total.get(gpu, 0) + count
        rankings.append(AccountUsage(account, total, users))
    return sorted(rankings, key=lambda row: (-sum(row.usage.values()), row.account))


def parse_sacct_history(rows, updated: float) -> HistorySnapshot:
    grouped: dict[str, dict[str, dict[str, int]]] = {}
    earliest = None
    for line in rows:
        if not line.strip():
            continue
        fields = [value.strip() for value in line.rstrip("\n").split("|")]
        if len(fields) != 6:
            raise ValueError("unexpected sacct history row (expected 6 fields)")
        job_id, account, user, elapsed, tres, start = fields
        # Only allocation records count. Steps share their parent's GPUs.
        if "." in job_id:
            continue
        usage = _typed_tres(tres)
        if not sum(usage.values()):
            continue
        seconds = int(elapsed)
        if seconds < 0:
            raise ValueError("negative elapsed time in sacct history")
        if not seconds:
            continue
        account = account if account not in {"", "N/A", "(null)"} else "unknown"
        user = user if user not in {"", "N/A", "(null)"} else "unknown"
        target = grouped.setdefault(account, {}).setdefault(user, {})
        for gpu, count in usage.items():
            if count:
                target[gpu] = target.get(gpu, 0) + count * seconds
        if _timestamp(start) < float("inf") and (earliest is None or start < earliest):
            earliest = start
    return HistorySnapshot(_rank_accounts(grouped), updated, earliest)


def _history_cache_path() -> Path:
    # Shared home directories may be used on several clusters or login hosts.
    identity = [os.uname().nodename, str(os.getuid())] + [
        os.environ.get(key, "")
        for key in ("SLURM_CONF", "SLURM_CONF_SERVER", "SLURM_CLUSTERS")
    ]
    key = hashlib.sha256(json.dumps(identity).encode()).hexdigest()[:20]
    root = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
    return root / "sinner-top" / f"history-v1-{key}.json"


def _read_history_cache() -> HistorySnapshot | None:
    try:
        data = json.loads(_history_cache_path().read_text())
        if data["version"] != 1 or not 0 < data["updated"] <= time.time() + 60:
            return None
        earliest = data["earliest"]
        if earliest is not None and _timestamp(earliest) == float("inf"):
            return None
        grouped = data["accounts"]
        for account, users in grouped.items():
            if not isinstance(account, str) or not account or not users:
                return None
            for user, usage in users.items():
                if not isinstance(user, str) or not user or not usage:
                    return None
                if any(not isinstance(gpu, str) or not gpu or type(value) is not int or value <= 0
                       for gpu, value in usage.items()):
                    return None
        return HistorySnapshot(_rank_accounts(grouped), data["updated"], earliest)
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return None


def _save_history_cache(history: HistorySnapshot) -> None:
    temporary = None
    try:
        path = _history_cache_path()
        path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        # NamedTemporaryFile is private (0600); replace keeps readers atomic.
        with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as out:
            temporary = out.name
            json.dump({
                "version": 1, "updated": history.updated, "earliest": history.earliest,
                "accounts": {row.account: row.users for row in history.accounts},
            }, out)
        os.replace(temporary, path)
    except OSError:
        pass  # A read-only cache directory must not hide a successful report.
    finally:
        if temporary:
            try:
                os.unlink(temporary)
            except OSError:
                pass


def collect_history() -> HistorySnapshot:
    command = [
        "sacct", "--local", "--allusers", "--allocations", "--array", "--duplicates",
        "--noheader", "--parsable2", "--noconvert", "--starttime=1970-01-01", "--endtime=now",
        "--format=JobIDRaw,Account%100,User%100,ElapsedRaw,AllocTRES%1000,Start",
    ]
    # Large accounting tables go through a temporary file, not a giant string.
    # This query runs only in the background, independently of the live refresh.
    updated = time.time()
    try:
        with tempfile.TemporaryFile(mode="w+t") as output:
            subprocess.run(
                command, stdout=output, stderr=subprocess.PIPE, text=True, check=True,
                timeout=HISTORY_TIMEOUT, env={**os.environ, "SLURM_TIME_FORMAT": "standard"},
            )
            output.seek(0)
            history = parse_sacct_history(output, updated)
    except subprocess.TimeoutExpired as error:
        raise SlurmCommandError(f"sacct timed out after {HISTORY_TIMEOUT}s; r: retry") from error
    except FileNotFoundError as error:
        raise SlurmCommandError("sacct is required for historical usage") from error
    except subprocess.CalledProcessError as error:
        raise SlurmCommandError(error.stderr.strip() or "sacct history query failed") from error
    _save_history_cache(history)
    return history


def _render_user_rows(
    lines: list[str],
    user_rows: list[
        tuple[
            int,
            str,
            dict[str, int],
            list[tuple[Job, list[Allocation], dict[str, int]]],
        ]
    ],
    *,
    max_jobs: int,
    show_ids: bool,
    color: bool,
    now: float,
    queued: bool = False,
    current_user: str | None = None,
) -> None:
    for user_index, (_, user, total, jobs) in enumerate(user_rows):
        if user_index:
            lines.append("")
        medal = RANK_MEDALS[user_index] if user_index < len(RANK_MEDALS) else "  "
        own = user == current_user
        user_label = f"{user} (you)" if own else user
        user_display = _style(
            f"{user_label:<16}", "1", "7" if own else "36", color=color
        )
        usage_display = _style(_usage_label(total), "1", "35", color=color)
        lines.append(f"{medal} {user_display}  {usage_display}")
        jobs = sorted(jobs, key=lambda row: _finish_key(row[0], now))
        shown = jobs[:max_jobs] if max_jobs else jobs
        omitted = len(jobs) - len(shown)
        for job_index, (job, allocations, usage) in enumerate(shown):
            is_last = job_index == len(shown) - 1 and omitted == 0
            branch = "└─" if is_last else "├─"
            remaining = _remaining_label(job.left)
            if queued:
                timing = (
                    f"{_style(_start_label(job.start, now), '1', '33', color=color)}"
                    f"  limit {remaining}"
                )
            else:
                timing = (
                    "end in "
                    f"{_style(remaining, '1', _remaining_color(job.left), color=color)}"
                )
            name = f"{job.name[:10]:<10}"
            is_array_task = "_" in job.job_id
            if is_array_task:
                name += f" [{job.job_id}]"
            name_display = _style(name, *(('1', '7') if own else ('1',)), color=color)
            detail = (
                f"  {_style(branch, '2', color=color)} "
                f"{name_display}  "
                f"{_style(f'{_usage_label(usage):<8}', '33', color=color)}  "
                f"{timing}"
            )
            if show_ids:
                if queued and not is_array_task:
                    detail += f"  │  job {job.job_id}"
                elif not queued:
                    detail += f"  │  {_id_label(allocations)}"
            lines.append(detail)
        if omitted:
            lines.append(
                _style("  └─ … more jobs hidden", "2", color=color)
            )


def render(
    snapshot: Snapshot,
    *,
    max_jobs: int = 5,
    show_ids: bool = False,
    color: bool = False,
    width: int | None = None,
    now: float | None = None,
    gpu_type: str | None = None,
    current_user: str | None = None,
) -> str:
    if width is None:
        width = shutil.get_terminal_size(fallback=(140, 24)).columns
    width = max(width, 20)
    if now is None:
        now = time.time()
    types = [gpu_type] if gpu_type else _available_gpu_types(snapshot)
    status = "  │  ".join(
        f"{gpu.upper()} idle {snapshot.idle.get(gpu, 0)}/{snapshot.total.get(gpu, 0)}, "
        f"active {snapshot.active.get(gpu, 0)}"
        if gpu != "any" or gpu in snapshot.total else "ANY: GPU type unspecified"
        for gpu in types
    )
    lines = [f"{_style('GPU STATUS', '1', '36', color=color)}  │  {status}"]
    lines = _wrap_line(lines[0], width)
    lines.append(_style("─" * width, "2", color=color))
    running_lines = [_style("RUNNING GPU JOBS", "1", "36", color=color), ""]
    queued_lines = [_style("PENDING GPU JOBS", "1", "36", color=color), ""]
    gpu_label = gpu_type.upper() if gpu_type else "GPU"
    running_rows = _group_jobs(snapshot, RUNNING_STATES, gpu_type)
    if not running_rows:
        running_lines.append(f"No running {gpu_label} jobs")
    else:
        _render_user_rows(
            running_lines,
            running_rows,
            max_jobs=max_jobs,
            show_ids=show_ids,
            color=color,
            now=now,
            current_user=current_user,
        )

    queued_rows = _group_jobs(snapshot, QUEUED_STATES, gpu_type)
    if not queued_rows:
        queued_lines.append(f"No pending {gpu_label} jobs")
    else:
        _render_user_rows(
            queued_lines,
            queued_rows,
            max_jobs=max_jobs,
            show_ids=show_ids,
            color=color,
            now=now,
            queued=True,
            current_user=current_user,
        )
    lines.extend(_side_by_side(running_lines, queued_lines, width))
    return "\n".join(lines)


@dataclass(frozen=True)
class PanelLine:
    text: str
    own: bool = False
    heading: bool = False
    remaining_seconds: float | None = None
    podium_rank: int | None = None
    flash: bool = False
    tints: tuple[tuple[int, int, int], ...] = ()  # character start, length, shade
    remaining_start: int | None = None  # only color the timing suffix, if given


@dataclass
class ViewState:
    gpu_type: str = "h200"
    gpu_types: list[str] = field(default_factory=lambda: list(PREFERRED_GPU_TYPES))
    pane: int = 0
    offsets: dict[tuple[str, int], int] = field(default_factory=dict)
    view: str = "jobs"
    history_page: str = "podium"
    ranking_offsets: dict[str, int] = field(default_factory=dict)
    effects: bool = True
    memes: bool = True
    animation_elapsed: float = 0.0
    animation_tick: float | None = None

    @property
    def rankings(self) -> bool:
        return self.view in {"live", "history"}

    @property
    def single_panel(self) -> bool:
        return self.view != "jobs"

    @property
    def focused_pane(self) -> int:
        return 0 if self.single_panel else self.pane

    def select_view(self, view: str) -> None:
        if view != self.view:
            self.view = view
            if view == "history":
                self.show_podium()

    def show_podium(self) -> None:
        self.history_page = "podium"
        # Start only once history is available; replay on every return.
        self.animation_tick = None
        self.animation_elapsed = 0.0 if self.effects else HERO_ENTRANCE_SECONDS

    def animate(self, now: float, ready: bool) -> None:
        if self.view != "history" or self.history_page != "podium" or not ready:
            return
        if self.animation_tick is not None and self.effects:
            self.animation_elapsed += max(0, now - self.animation_tick)
        self.animation_tick = now

    def offset(self, pane: int) -> int:
        if self.single_panel:
            return self.ranking_offsets.get(self.view, 0)
        return self.offsets.get((self.gpu_type, pane), 0)

    def clamp(self, counts: Sequence[int], page_height: int) -> None:
        for pane, count in enumerate(counts[:1] if self.single_panel else counts):
            offset = min(max(0, self.offset(pane)), max(0, count - page_height))
            if self.single_panel:
                self.ranking_offsets[self.view] = offset
            else:
                self.offsets[self.gpu_type, pane] = offset


def _handle_key(
    state: ViewState, key: int, page_height: int, counts: Sequence[int],
) -> str:
    if key in (ord("q"), ord("Q")):
        return "quit"
    if key == ord("r"):
        return "refresh"
    if key in (ord("0"), ord("a"), ord("t"), ord("n")):
        target = {ord("t"): "history", ord("n"): "nodes"}.get(key, "live")
        state.select_view("jobs" if state.view == target else target)
        return ""
    if key == ord("e") and state.view == "history":
        state.effects = not state.effects
        return ""
    if key == ord("m") and state.view == "history":
        state.memes = not state.memes
        return ""
    if state.view == "history":
        if state.history_page == "podium" and key in (curses.KEY_DOWN, ord("j"), curses.KEY_NPAGE, 4, ord(" "), 10, 13):
            state.history_page = "all" if key in (10, 13) else "rest"
            state.ranking_offsets["history"] = 0
            return ""
        if key in (ord("b"), curses.KEY_BACKSPACE, 127) or (
            state.history_page != "podium" and state.offset(0) == 0 and key in (curses.KEY_UP, ord("k"))
        ):
            state.show_podium()
            return ""
    pane = state.focused_pane
    if state.view == "nodes" and key in (curses.KEY_LEFT, curses.KEY_RIGHT, ord("h"), ord("l"), ord("\t")):
        state.select_view("jobs")
        state.pane = 0 if key in (curses.KEY_LEFT, ord("h")) else 1
        return ""
    if state.rankings and key in (curses.KEY_LEFT, curses.KEY_RIGHT, ord("h"), ord("l"), ord("\t")):
        target = "live" if key in (curses.KEY_LEFT, ord("h")) else "history"
        if key == ord("\t"):
            target = "live" if state.view == "history" else "history"
        state.select_view(target)
        return ""
    if key in (curses.KEY_LEFT, ord("h")):
        pane = 0
    elif key in (curses.KEY_RIGHT, ord("l")):
        pane = 1
    elif key == ord("\t"):
        pane = 1 - pane
    elif key in (ord("["), ord("]"), ord("g")) or key in range(ord("1"), ord("9") + 1):
        if key in (ord("["), ord("]"), ord("g")):
            views = state.gpu_types + ["nodes", "live", "history"]
            index = views.index(state.view if state.single_panel else state.gpu_type)
            target = views[(index + (-1 if key == ord("[") else 1)) % len(views)]
            if target in ("nodes", "live", "history"):
                state.select_view(target)
            else:
                state.gpu_type = target
                state.select_view("jobs")
        else:
            gpu = _gpu_shortcuts(state.gpu_types).get(chr(key))
            if gpu is not None:
                state.gpu_type = gpu
                state.select_view("jobs")
        return ""
    else:
        offset = state.offset(pane)
        if key in (curses.KEY_DOWN, ord("j")):
            offset += 5
        elif key in (curses.KEY_UP, ord("k")):
            offset -= 5
        elif key in (curses.KEY_NPAGE, 4):
            offset += page_height
        elif key in (curses.KEY_PPAGE, 21):
            offset -= page_height
        elif key == curses.KEY_HOME:
            offset = 0
        elif key in (curses.KEY_END, ord("G")):
            offset = counts[pane]
        if state.single_panel:
            state.ranking_offsets[state.view] = offset
        else:
            state.offsets[state.gpu_type, pane] = offset
    if not state.single_panel:
        state.pane = pane
    state.clamp(counts, page_height)
    return ""


def _panel_lines(
    snapshot: Snapshot,
    states: set[str],
    gpu_type: str,
    width: int,
    current_user: str,
    now: float,
    *,
    max_jobs: int | None = None,
    show_ids: bool = False,
) -> tuple[list[PanelLine], int]:
    lines: list[PanelLine] = []
    groups = _group_jobs(snapshot, states, gpu_type)
    job_count = sum(len(group[3]) for group in groups)

    def append(
        text: str, own: bool = False, heading: bool = False,
        remaining_seconds: float | None = None,
    ) -> None:
        lines.extend(
            PanelLine(part, own, heading, remaining_seconds)
            for part in _wrap_line(text, width)
        )

    for rank, (_, user, total, jobs) in enumerate(groups, 1):
        if lines:
            append("")
        own = user == current_user
        who = f"{user} (you)" if own else user
        append(f"{rank}. {who}  {total[gpu_type]}×{gpu_type.upper()}", own, True)
        jobs = sorted(jobs, key=lambda row: _finish_key(row[0], now))
        shown = jobs[:max_jobs] if max_jobs else jobs
        for index, (job, allocations, usage) in enumerate(shown):
            branch = "└─" if index == len(jobs) - 1 else "├─"
            append(f"  {branch} {job.name} [{job.job_id}]  {_usage_label(usage)}", own)
            remaining_seconds = None
            if job.state.upper() in QUEUED_STATES:
                timing = f"{_start_label(job.start, now)}  limit {_remaining_label(job.left)}"
            else:
                end = _timestamp(job.end)
                remaining_seconds = (
                    max(0, end - now)
                    if end < float("inf") else _remaining_seconds(job.left)
                )
                timing = f"end in {_duration_label(remaining_seconds)}"
            append(f"     {timing}", own, remaining_seconds=remaining_seconds)
            if show_ids and job.state.upper() in RUNNING_STATES:
                append(f"     {_id_label(allocations)}", own)
        omitted = len(jobs) - len(shown)
        if omitted:
            append("  └─ … more jobs (--max-jobs 0 shows all)", own)
    if not lines:
        state_label = "pending" if states == QUEUED_STATES else "running"
        append(f"No {state_label} {gpu_type.upper()} jobs")
    return lines, job_count


def _node_lines(snapshot: Snapshot, width: int, current_user: str, now: float) -> list[PanelLine]:
    """H200 node inventory and actual per-node job allocations."""
    nodes = {node.name: node for node in snapshot.nodes if node.total.get("h200", 0)}
    grouped: dict[str, list[tuple[Job, list[Allocation]]]] = {name: [] for name in nodes}
    for job in snapshot.jobs:
        if job.state.upper() not in RUNNING_STATES:
            continue
        local: dict[str, list[Allocation]] = {}
        for allocation in snapshot.allocations.get(job.job_id, []):
            node = nodes.get(allocation.node)
            if node is not None and (
                allocation.gpu_type == "h200"
                or (allocation.gpu_type == "any" and len(node.total) == 1)
            ):
                local.setdefault(node.name, []).append(allocation)
        for name, allocations in local.items():
            grouped[name].append((job, allocations))

    lines: list[PanelLine] = []

    def append(text: str, own: bool = False, heading: bool = False, remaining: float | None = None):
        lines.extend(PanelLine(part, own, heading, remaining) for part in _wrap_line(text, width))

    ordered = sorted(nodes.values(), key=lambda node: (
        not _node_is_schedulable(node.state), -node.idle("h200"), node.name,
    ))
    for node in ordered:
        if lines:
            append("")
        used = node.allocated.get("h200", 0)
        append(f"{node.name}  |  free {node.free('h200')}/{node.total['h200']}  used {used}  |  {node.state}", heading=True)
        if not _node_is_schedulable(node.state):
            append("  Unavailable for new jobs (node state)")
        visible = 0
        for job, allocations in sorted(grouped[node.name], key=lambda row: _finish_key(row[0], now)):
            count = sum(allocation.count for allocation in allocations)
            visible += count
            ids = ",".join(allocation.indices for allocation in allocations)
            own = job.user == current_user
            who = f"{job.user} (you)" if own else job.user
            prefix = f"  GPU {ids} ({count})  {who} [{job.job_id}]"
            end = _timestamp(job.end)
            remaining = max(0, end - now) if math.isfinite(end) else _remaining_seconds(job.left)
            timing = f"end in {_duration_label(remaining)}"
            if job.state.upper() == "COMPLETING":
                timing = "completing / releasing"
                remaining = None
            available = width - _display_width(prefix) - _display_width(timing) - 4
            if available >= 4:
                text = prefix + "  " + _clip_text(job.name, available)
                text += " " * (width - _display_width(text) - _display_width(timing))
                lines.append(PanelLine(text + timing, own=own, remaining_seconds=remaining, remaining_start=len(text)))
            else:
                append(f"{prefix}  {job.name}", own)
                append(f"    {timing}", own, remaining=remaining)
        if visible < used:
            append(f"  {used - visible} allocated GPU(s): job details unavailable")
        elif visible > used:
            append("  Allocation totals changed during refresh; awaiting next snapshot")
        elif used == 0:
            append("  No allocated GPUs")
    if not nodes:
        append("No H200 nodes reported by Slurm")
    return lines


def _podium_visible(state: ViewState) -> bool:
    return state.view == "history" and state.history_page == "podium"


def _hero_layout(width: int, height: int) -> list[tuple[int, int, int, int]]:
    # The winner gets one half; runners-up share the other half vertically.
    left = (width - 1) // 2
    body = max(2, height - 5)
    upper = body // 2
    return [(0, 2, left, body), (left + 1, 2, width - left - 1, upper),
            (left + 1, 2 + upper, width - left - 1, body - upper)]


def _center_label(text: str, width: int) -> str:
    text = _clip_text(text, width)
    space = width - _display_width(text)
    return " " * (space // 2) + text + " " * (space - space // 2)


def _compact_hours(seconds: int) -> str:
    hours = seconds / 3600
    if hours >= 1000:
        return f"{hours / 1000:.1f}kh"
    return f"{hours:.1f}h"


def _account_banner(name: str, width: int, max_height: int) -> list[str]:
    """Keep complete letters, condensing or wrapping long account names."""
    glyphs = [ACCOUNT_LETTERS.get(char, ACCOUNT_LETTERS["?"]).split("/") for char in (name or "?").upper()]
    glyph_width = 5
    if len(glyphs) * 6 - 1 > width:
        glyph_width = 3
        glyphs = [["".join("1" if "1" in group else "0" for group in (row[:2], row[2:3], row[3:]))
                   for row in glyph] for glyph in glyphs]
    per_line = max(1, (width + 1) // (glyph_width + 1))
    rows = []
    for start in range(0, len(glyphs), per_line):
        if rows:
            rows.append("")
        rows.extend(" ".join(glyph[y] for glyph in glyphs[start:start + per_line]).translate(str.maketrans("01", " #"))
                    for y in range(5))
    if len(rows) > max_height or any(len(row) > width for row in rows):
        return _wrap_line(f"[ {name} ]", width)[:max_height]
    return rows


def _tint_runs(shades: Sequence[int], offset: int = 0) -> tuple[tuple[int, int, int], ...]:
    runs = []
    start = 0
    for end in range(1, len(shades) + 1):
        if end == len(shades) or shades[end] != shades[start]:
            runs.append((offset + start, end - start, shades[start]))
            start = end
    return tuple(runs)


def _sculpted_art(rows: Sequence[str], elapsed: float, *, lettering: bool = False):
    """Opaque art with an offset shadow, bevel lighting and a travelling shine."""
    width = max(map(len, rows), default=0)
    source = [row.ljust(width) for row in rows]
    pixels = [list(row) for row in source]
    shades = [[0] * width for _ in source]
    sweep = (elapsed * (8 if lettering else 6)) % (width + 14) - 7
    for y, row in enumerate(source):
        for x, char in enumerate(row):
            if char == " ":
                continue
            # The shadow stays behind the original contours and letter strokes.
            for dx, dy, shadow in ((1, 1, ":"), (2, 1, ".")):
                sx, sy = x + dx, y + dy
                if sy < len(source) and sx < width and source[sy][sx] == " ":
                    pixels[sy][sx] = shadow
                    shades[sy][sx] = 1 if dx == 1 else 0
    for y, row in enumerate(source):
        for x, char in enumerate(row):
            if char == " ":
                continue
            light = 5 if y == 0 or source[y - 1][x] == " " else 3
            if x == 0 or source[y][x - 1] == " ":
                light = max(light, 4)
            if not lettering and y > len(source) * .6:
                light = max(2, light - 1)
            distance = abs(x + y * .6 - sweep)
            if distance < 1.2:
                light = 6
            elif distance < 2.7:
                light = 5
            shades[y][x] = light
    return ["".join(row) for row in pixels], shades


def _border_tints(text: str, phase: int, flash: bool = False):
    return _tint_runs([
        6 if flash or (x - phase) % 17 < 2 else 4 if (x - phase) % 17 < 6 else 2
        for x in range(len(text))
    ])


def _hero_card(
    account: AccountUsage, rank: int, width: int, height: int,
    elapsed: float, current_user: str, memes: bool = True,
) -> list[PanelLine]:
    own = current_user in account.users
    users = sorted(account.users.items(), key=lambda row: (-sum(row[1].values()), row[0]))
    hours = sum(account.usage.values()) / 3600
    total = f"{hours:,.1f} GPU-h"
    if _display_width(total) > width - 2:
        total = f"{hours / 1000:.1f}kh" if hours >= 1000 else f"{hours:.1f}h"
    if height < 8:
        text = [f"#{rank + 1} {account.account}", total, HERO_CAPTIONS[rank]]
        return [PanelLine(_center_label(line, width), own, True, podium_rank=rank) for line in text[:height]]
    inner = width - 2
    short_header = rank > 0 and height < 13
    side_details = rank > 0
    if short_header:
        parts = []
        for gpu in _ordered_gpu_types(account.usage):
            value = account.usage[gpu] / 3600
            value = f"{value / 1000:.0f}k" if value >= 1000 else f"{value:.0f}"
            parts.append(f"{gpu.upper()}~{value}")
        type_text = " ".join(parts)
        if _display_width(type_text) > inner:
            type_text = _clip_text(type_text, inner - 1) + "…"
        type_lines = [type_text]
    else:
        type_text = "  ".join(f"{gpu.upper()}:{_compact_hours(account.usage[gpu])}" for gpu in _ordered_gpu_types(account.usage))
        type_lines = _wrap_line(type_text, inner)[:2]
    banner = []
    if rank == 0:
        minimum_user_rows = (len(users) + 1) // 2 if inner >= 32 else len(users)
        banner_budget = max(1, height - 4 - len(type_lines) - minimum_user_rows - 5)
        banner = _account_banner(account.account, inner, banner_budget)
    detail_cols = 1
    if side_details:
        body_height = height - (2 if short_header else 5) - len(type_lines)
        user_rows = 0
        art_width = max(9, min(23, inner // 2 - 2))
        detail_width = max(1, inner - art_width - 2)
    else:
        reserved = 4 + len(banner)
        preferred_face_height = 18 if inner >= 44 and height >= 30 else 9
        if height - reserved - len(type_lines) - len(users) < preferred_face_height and inner >= 32:
            detail_cols = 2
        user_rows = min((len(users) + detail_cols - 1) // detail_cols, max(0, height - reserved - 3 - len(type_lines)))
        body_height = height - reserved - len(type_lines) - user_rows
        art_width = inner
        detail_width = inner // detail_cols
    meme_index = 1 - rank if rank < 2 else rank
    if not memes or body_height < 5 or art_width < 11:
        face = [("[###]-[###]", r"( o\_/o )", "( @__O )")[meme_index]]
    else:
        source = HERO_FACES if body_height >= 9 and art_width >= 22 else HERO_COMPACT_FACES
        face = source[meme_index].splitlines()
    face_width = max(map(len, face))
    face = [line.ljust(face_width) for line in face]
    if rank == 0 and memes and art_width >= face_width * 2 + 4 and body_height >= len(face) * 2:
        face = ["".join(char * 2 for char in line) for line in face for _ in range(2)]
        face_width *= 2
    local = max(0.0, elapsed - rank * 0.22)
    impact = 0.65 <= local < 0.95
    phase = int(elapsed * 10)
    canvas = [[" "] * inner for _ in range(body_height)]
    canvas_shades = [[0] * inner for _ in range(body_height)]

    def put(y: int, x: int, value: str, shade: int = 2) -> None:
        if 0 <= y < body_height:
            for dx, char in enumerate(value):
                if 0 <= x + dx < inner:
                    canvas[y][x + dx] = char
                    canvas_shades[y][x + dx] = shade

    # Parallax motes: brighter particles travel faster and leave dim tails.
    for n in range(max(10, art_width * body_height // 35)):
        speed = 1 + n % 3
        y = (n * 7 - phase // (4 - speed)) % body_height
        x = (n * 17 + phase * speed // 3 + rank * 5) % art_width
        put(y, x - 2, "..", 0)
        put(y, x, (".", "+", "*", "o")[(phase // 4 + n) % 4], 3 + n % 4)
    # Light fans and comets cross the space behind the stationary face.
    margin = max(2, (art_width - face_width) // 2)
    for y in range(body_height):
        for ray in range(3):
            reach = int(y * (.35 + ray * .2) + elapsed * (1.2 + ray)) % (margin + 3)
            put(y, reach, "/" if y < body_height // 2 else "\\", 1 + ray)
            put(y, art_width - 1 - reach, "\\" if y < body_height // 2 else "/", 1 + ray)
    for n in range(2):
        x = (phase * 2 + n * 23) % (art_width + 8) - 4
        y = (phase // 3 + n * 5) % body_height
        put(y, x - 3, "...", 1)
        put(y, x - 1, "-", 3)
        put(y, x, "*", 6)
    # Four-point flares and a repeating halo, with a larger landing shockwave.
    for n in range(2):
        x = (phase // 3 + n * 19 + rank * 3) % art_width
        y = (n * 5 + phase // 7) % body_height
        if (phase // 3 + n) % 4 < 2:
            put(y - 1, x, "|", 3)
            put(y, x - 1, "-+-", 5)
            put(y + 1, x, "|", 3)
    burst = local - .65 if impact else (elapsed + rank * .7) % 4.5
    if 0 <= burst < .9:
        center_x = art_width // 2 if impact else max(2, margin // 2)
        center_y = body_height // 2 if impact else body_height // 3
        radius = burst * (art_width * 1.6 if impact else 8)
        for n in range(16):
            angle = n * math.pi / 8
            x = round(center_x + math.cos(angle) * radius)
            y = round(center_y + math.sin(angle) * radius * .5)
            put(y, x, "*" if n % 2 else "+", 6 if impact else 4 + n % 3)
    if impact:
        for y in range(body_height):
            put(y, 0, ">>>" if y % 2 else "***", 6)
            put(y, art_width - 3, "<<<" if y % 2 else "***", 6)
    progress = min(1.0, local / 0.65)
    x = (art_width - face_width) // 2
    y = (body_height - len(face)) // 2
    if rank == 0:
        x = round(-face_width + (x + face_width) * progress)
    elif rank == 1:
        y = round(-len(face) + (y + len(face)) * progress)
    else:
        x = round(inner + (x - inner) * progress)
    face, face_shades = _sculpted_art(face, elapsed)
    for dy, line in enumerate(face):
        put(y + dy, x, line)
        if 0 <= y + dy < body_height:
            for dx, shade in enumerate(face_shades[dy]):
                if 0 <= x + dx < inner:
                    canvas_shades[y + dy][x + dx] = shade
    title = f" #{rank + 1} {HERO_TITLES[rank]} "
    if local < 0.65:
        title = f" >>> #{rank + 1} INCOMING <<< "
    elif impact:
        title = f" *** #{rank + 1} LANDED! *** "
    text = _clip_text(title, inner)
    padding = inner - len(text)
    border = "+" + "=" * (padding // 2) + text + "=" * (padding - padding // 2) + "+"
    if short_header:
        header = f"#{rank + 1} {account.account}  {_gpu_hours(sum(account.usage.values()))}h"
        lines = [PanelLine("+" + _center_label(header, inner) + "+", own, True, podium_rank=rank, flash=impact)]
    else:
        lines = [
            PanelLine(border, podium_rank=rank, flash=impact, tints=_border_tints(border, phase, impact)),
            PanelLine("|" + _center_label(account.account, inner) + "|", own, True, podium_rank=rank),
            PanelLine("|" + _center_label(total, inner) + "|", podium_rank=rank),
        ]
    lines.extend(PanelLine("|" + _center_label(line, inner) + "|", podium_rank=rank) for line in type_lines)

    def user_label(index, user, usage, columns):
        who = f"{user} (you)" if user == current_user else user
        hours = f"{_gpu_hours(sum(usage.values()))}h"
        text = f"{index}. {who}  {hours}"
        if _display_width(text) > columns:
            text = f"{index}. {who} {_compact_hours(sum(usage.values()))}"
        return _clip_text(text, columns)

    for y, row in enumerate(canvas):
        line_own = False
        if side_details:
            start = art_width + 2
            # Account members are visible by default alongside the meme.
            detail = ""
            if y < len(users):
                user, usage = users[y]
                detail = user_label(y + 1, user, usage, detail_width)
                line_own = user == current_user
            if y == body_height - 1 and len(users) > body_height:
                detail = f"+{len(users) - y} more (Enter)"
                line_own = False
            row[start:] = list(_clip_text(detail, detail_width).ljust(detail_width))
        tinted_width = art_width if side_details else inner
        tints = _tint_runs(canvas_shades[y][:tinted_width], 1)
        tints += ((0, 1, 5 if (phase + y) % 9 < 2 else 2),)
        lines.append(PanelLine("|" + "".join(row) + "|", line_own, podium_rank=rank, tints=tints))
    caption = HERO_CAPTIONS[rank] if local >= 0.95 else "POWERING UP..."
    if banner:
        letter_rows = [_center_label(row, inner) for row in banner]
        letter_rows, letter_shades = _sculpted_art(letter_rows, elapsed, lettering=True)
        lines.extend(PanelLine("|" + row + "|", heading=True, podium_rank=rank,
                              tints=_tint_runs(shades, 1))
                     for row, shades in zip(letter_rows, letter_shades))
    elif not short_header:
        lines.append(PanelLine("|" + _center_label(caption, inner) + "|", podium_rank=rank, flash=impact))
    for y in range(user_rows):
        cells = []
        line_own = False
        for column in range(detail_cols):
            index = y + column * user_rows
            text = ""
            if index < len(users):
                user, usage = users[index]
                text = user_label(index + 1, user, usage, detail_width)
                line_own |= user == current_user
            if y == user_rows - 1 and column == detail_cols - 1 and len(users) > user_rows * detail_cols:
                text = f"+{len(users) - index} more (Enter)"
            cells.append(_center_label(text, detail_width))
        lines.append(PanelLine("|" + _center_label("".join(cells), inner) + "|", line_own, podium_rank=rank))
    beam = ("==->>==" if phase % 2 else "->>====") * (width // 7 + 1)
    bottom = _center_label(caption, inner) if short_header else beam[:inner]
    text = "+" + bottom + "+"
    lines.append(PanelLine(text, podium_rank=rank, flash=impact, tints=_border_tints(text, -phase, impact)))

    return lines


def _draw_heroes(screen, state, history, current_user, podium_attrs, own_attr, shine_attr, hero_palettes=()):
    if history is None or not history.accounts:
        return
    height, width = screen.getmaxyx()
    for rank, (start, top, card_width, card_height) in enumerate(_hero_layout(width, height)):
        if rank >= len(history.accounts):
            _write(screen, top, start, f"#{rank + 1} — no GPU usage", card_width, curses.A_DIM)
            continue
        account = history.accounts[rank]
        lines = _hero_card(account, rank, card_width, card_height, state.animation_elapsed, current_user, state.memes)
        for y, line in enumerate(lines, top):
            attr = podium_attrs[rank] if podium_attrs else curses.A_BOLD
            if line.flash:
                attr = shine_attr
            if line.own:
                attr = own_attr | curses.A_BOLD
            _write(screen, y, start, line.text, card_width, attr)
            palette = hero_palettes[rank] if hero_palettes else (
                curses.A_DIM, curses.A_DIM, 0, 0, curses.A_BOLD, curses.A_BOLD, curses.A_BOLD,
            )
            for offset, length, shade in line.tints:
                text = line.text[offset:offset + length]
                _write(screen, y, start + offset, text, length, palette[shade])


def _gpu_hours(seconds: int) -> str:
    return f"{seconds / 3600:,.1f}"


def _usage_ranking_lines(
    accounts: Sequence[AccountUsage], width: int, current_user: str,
    *, historical: bool = False, start_rank: int = 0,
) -> list[PanelLine]:
    lines: list[PanelLine] = []

    def append(text: str, own: bool = False, heading: bool = False, rank: int | None = None) -> None:
        lines.extend(PanelLine(part, own, heading, podium_rank=rank) for part in _wrap_line(text, width))

    def rank_label(index: int) -> str:
        return RANK_MEDALS[index] if index < len(RANK_MEDALS) else f"{index + 1}."

    def total_label(usage: dict[str, int]) -> str:
        total = sum(usage.values())
        return f"{_gpu_hours(total)} GPU-h" if historical else f"{total} GPUs"

    def breakdown(usage: dict[str, int]) -> str:
        if not historical:
            return _usage_label(usage)
        return "  ".join(f"{gpu.upper()}:{_gpu_hours(usage[gpu])}h" for gpu in _ordered_gpu_types(usage))

    for index, row in enumerate(accounts, start_rank):
        if lines:
            append("")
        append(
            f"{rank_label(index)} {row.account}  {total_label(row.usage)}",
            current_user in row.users, True, index if index < 3 else None,
        )
        append(f"   {breakdown(row.usage)}", current_user in row.users)
        users = sorted(row.users.items(), key=lambda item: (-sum(item[1].values()), item[0]))
        for user_index, (user, usage) in enumerate(users):
            branch = "└─" if user_index == len(users) - 1 else "├─"
            who = f"{user} (you)" if user == current_user else user
            append(
                f"  {branch} {rank_label(user_index)} {who}  {total_label(usage)}",
                user == current_user, rank=user_index if user_index < 3 else None,
            )
            if len(usage) > 1:
                append(f"       {breakdown(usage)}", user == current_user)
    if not lines:
        append("No GPU usage in available history" if historical else "No running GPU allocations to rank")
    return lines


def _ranking_lines(
    snapshot: Snapshot, width: int, current_user: str,
) -> list[PanelLine]:
    return _usage_ranking_lines(_account_rankings(snapshot), width, current_user)


def _history_lines(
    history: HistorySnapshot | None, width: int, current_user: str,
    error: str = "", loading: bool = False, start_rank: int = 0,
) -> list[PanelLine]:
    intro = ["GPU-hours = GPUs x elapsed hours"]
    if history is not None:
        since = history.earliest[:10] if history.earliest else "unknown"
        intro.append(f"Retained records since {since}")
        date = time.strftime("%m-%d %H:%M", time.localtime(history.updated))
        intro.append(f"As of {date} | refresh 15m" + (" (loading...)" if loading else ""))
    if error:
        intro.append(f"History unavailable: {error} (r: retry)")
        if history is not None:
            intro.append("Showing last successful history")
    elif history is None:
        intro.append("Loading all retained Slurm history...")
    lines = [PanelLine(part) for line in intro for part in _wrap_line(line, width)]
    if history is not None:
        lines.append(PanelLine(""))
        if start_rank and len(history.accounts) <= start_rank:
            lines.append(PanelLine("No accounts below the top three. Enter on the podium shows all users."))
        else:
            lines.extend(_usage_ranking_lines(history.accounts[start_rank:], width, current_user,
                                            historical=True, start_rank=start_rank))
    return lines


class SnapshotLoader:
    """Fetch Slurm data off the input thread so navigation stays responsive."""

    def __init__(self, collector=None) -> None:
        self.collector = collector
        self.results: queue.Queue[tuple[Snapshot | HistorySnapshot | None, str]] = queue.Queue()
        self.running = False

    def request(self) -> None:
        if self.running:
            return
        self.running = True
        threading.Thread(target=self._collect, daemon=True).start()

    def _collect(self) -> None:
        try:
            self.results.put(((self.collector or collect_snapshot)(), ""))
        except Exception as error:
            self.results.put((None, str(error)))

    def poll(self) -> tuple[Snapshot | HistorySnapshot | None, str] | None:
        try:
            result = self.results.get_nowait()
        except queue.Empty:
            return None
        self.running = False
        return result


def _clip_text(text: str, width: int) -> str:
    result: list[str] = []
    used = 0
    for char in text:
        if unicodedata.category(char) == "Cc":
            char = " "
        size = _display_width(char)
        if used + size > width:
            break
        result.append(char)
        used += size
    return "".join(result)


def _gpu_footer(state: ViewState, width: int) -> tuple[str, str]:
    keys = {gpu: key for key, gpu in _gpu_shortcuts(state.gpu_types).items()}
    labels = {gpu: f"{keys[gpu]}:{gpu.upper()}" if gpu in keys else gpu.upper() for gpu in state.gpu_types}
    selected = {"nodes": "n:NODES", "live": "0:LIVE", "history": "t:TOTAL"}.get(state.view, labels[state.gpu_type])
    footer = "  ".join(labels[gpu] for gpu in state.gpu_types) + "  n:NODES  0:LIVE  t:TOTAL  [/]/g:view"
    if _display_width(footer) > width:
        footer = "n:NODES 0:LIVE t:TOTAL g:view"
        if not state.single_panel:
            footer = f"{selected} " + footer
        if _display_width(footer) > width:
            footer = f"{selected} n:nodes g:view" if not state.single_panel else f"{selected} g:view"
    return footer, selected


def _write(screen, y: int, x: int, text: str, width: int, attr: int = 0) -> None:
    height, columns = screen.getmaxyx()
    width = min(width, columns - x)
    if not (0 <= y < height and 0 <= x < columns) or width <= 0:
        return
    clipped = _clip_text(text, width)
    padded = clipped + " " * (width - _display_width(clipped))
    try:
        screen.addstr(y, x, padded, attr)
    except curses.error:
        # ncurses may report an error after writing the bottom-right cell, or
        # when tmux resizes the pane between getmaxyx() and addstr().
        pass


def _draw_screen(
    screen,
    state: ViewState,
    panels: Sequence[tuple[list[PanelLine], int]],
    snapshot: Snapshot | None,
    current_user: str,
    interval: float,
    updated: float | None,
    error: str,
    loading: bool,
    title_attr: int,
    own_attr: int,
    remaining_attrs: dict[str, int] | None = None,
    podium_attrs: Sequence[int] = (),
    history: HistorySnapshot | None = None,
    shine_attr: int = curses.A_BOLD,
    history_error: str = "",
    history_loading: bool = False,
    hero_palettes: Sequence[Sequence[int]] = (),
) -> None:
    height, width = screen.getmaxyx()
    screen.erase()
    if width < 30 or height < 8:
        _write(screen, 0, 0, "Resize to at least 30×8", width, curses.A_BOLD)
        _write(screen, height - 1, 0, "n:NODES g:view q:quit", width)
        screen.refresh()
        return
    gpu = "h200" if state.view == "nodes" else state.gpu_type
    inventory = (
        f"idle {snapshot.idle.get(gpu, 0)}/{snapshot.total.get(gpu, 0)}  active {snapshot.active.get(gpu, 0)}"
        if snapshot else "Loading Slurm jobs…"
    )
    if gpu == "any" and snapshot and gpu not in snapshot.total:
        inventory = "GPU type unspecified"
    title = {
        "live": "sinner-top  LIVE RANKING  |  current GPU use",
        "history": "sinner-top  ALL-TIME RANKING  |  cumulative GPU hours",
        "nodes": f"sinner-top  H200 NODES  |  {inventory}",
    }.get(state.view, f"sinner-top  {gpu.upper()}  |  {inventory}")
    _write(screen, 0, 0, title, width, title_attr)
    updated_label = time.strftime("%H:%M:%S", time.localtime(updated)) if updated else "--:--:--"
    meta = f"Updated {updated_label}  refresh {interval:g}s  |  you: {current_user} (highlighted)"
    if state.view == "history":
        meta = f"you: {current_user} (highlighted)  |  all GPU types  |  GPUs x elapsed hours"
        if history is not None:
            since = history.earliest[:10] if history.earliest else "unknown"
            date = time.strftime("%m-%d %H:%M", time.localtime(history.updated))
            meta = f"you: {current_user}  |  retained since {since}  |  as of {date} (refresh 15m)"
    _write(screen, 1, 0, meta, width, curses.A_DIM)
    left_width = (width - 1) // 2
    widths = (left_width, width - left_width - 1)
    starts = (0, left_width + 1)
    podium = _podium_visible(state) and history is not None and bool(history.accounts)
    if podium:
        _draw_heroes(screen, state, history, current_user, podium_attrs, own_attr, shine_attr, hero_palettes)
    label_y = 2
    page_height = height - 6
    if state.single_panel:
        label = "ACCOUNTS / USERS — GPU HOURS" if state.view == "history" else "ACCOUNTS / USERS — GPUs IN USE"
        if state.view == "nodes":
            label = "NODE / GPU / USER / JOB — time to Slurm limit"
        if state.view == "history" and state.history_page == "rest":
            label = "RANK #4+ / USERS — GPU HOURS"
        layout = [(label, panels[0][0], 0, width)]
    else:
        layout = [
            (("RUNNING", "PENDING")[pane], lines, starts[pane], widths[pane])
            for pane, (lines, _) in enumerate(panels)
        ]
    for pane, (label, lines, start, pane_width) in enumerate([] if podium else layout):
        focused = state.focused_pane == pane
        attr = title_attr | (curses.A_REVERSE if focused else 0)
        _write(screen, label_y, start, f"{'>' if focused else ' '} {label}", pane_width, attr)
        visible = lines[state.offset(pane):state.offset(pane) + page_height]
        for row, line in enumerate(visible, label_y + 1):
            attr = own_attr if line.own else 0
            if not line.own and line.podium_rank is not None:
                attr = podium_attrs[line.podium_rank] if podium_attrs else curses.A_BOLD
            if line.heading:
                attr |= curses.A_BOLD
            _write(screen, row, start, line.text, pane_width, attr)
            if line.remaining_seconds is not None and remaining_attrs:
                timing = line.text.lstrip() if line.remaining_start is None else line.text[line.remaining_start:]
                indent = _display_width(line.text) - _display_width(timing)
                # Keep the user's highlight in the row margins. Draw the time
                # on the terminal background so green text stays readable.
                _write(
                    screen, row, start + indent, timing,
                    _display_width(timing),
                    remaining_attrs[_duration_color(line.remaining_seconds)],
                )
    if not state.single_panel:
        for row in range(2, height - 3):
            _write(screen, row, left_width, "│", 1, curses.A_DIM)
    pane = state.focused_pane
    count = len(panels[pane][0])
    first = state.offset(pane) + 1 if count else 0
    last = min(state.offset(pane) + page_height, count)
    label = {"nodes": "Nodes", "history": "Total", "live": "Live"}.get(state.view, ("Running", "Pending")[pane])
    status = f"{label} lines {first}–{last}/{count}  |  PgUp/PgDn Home/End"
    if podium:
        status = "PODIUM 1-3  |  Down/j: next page (#4+)  Enter: full details"
    if state.view == "history":
        error, loading = history_error, history_loading
    if error:
        status = f"Slurm: {error}  (r: retry)"
    elif loading:
        status += "  |  Refreshing…"
    _write(screen, height - 3, 0, status, width, curses.A_DIM)
    controls = "←/h →/l pane  ↑/k ↓/j 5 lines  r:refresh  q:quit"
    if state.rankings:
        controls = "h:live l:total  ↑/k ↓/j 5 lines  0/t:back  r:refresh  q:quit"
    if state.view == "nodes":
        controls = "↑/k ↓/j 5 lines  n:back  h:running l:pending  r:refresh  q:quit"
    if state.view == "history":
        effects = "pause" if state.effects else "play"
        controls = (f"h:live  e:{effects} FX  m:art  t:back  r:refresh  q:quit" if podium
                    else "↑/k ↓/j 5 lines  b:podium  h:live  t:back  r:refresh  q:quit")
    if width < _display_width(controls):
        controls = {"nodes": "j/k:5 n:back r:refresh q:quit", "history": "j/k:5 e:FX m:art t:back q:quit", "live": "j/k:5 l:total 0:back q:quit"}.get(state.view, "h/l:pane j/k:5lines q:quit")
    _write(screen, height - 2, 0, controls, width, curses.A_DIM)
    footer, selected = _gpu_footer(state, width)
    _write(screen, height - 1, 0, footer, width)
    _write(screen, height - 1, footer.index(selected), selected, len(selected), title_attr | curses.A_REVERSE)
    screen.refresh()


def _interactive(screen, args: argparse.Namespace, use_color: bool, current_user: str) -> int:
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    curses.set_escdelay(25)
    screen.keypad(True)
    screen.timeout(100)
    title_attr = curses.A_BOLD
    own_attr = curses.A_REVERSE
    remaining_attrs: dict[str, int] = {}
    podium_attrs: list[int] = []
    hero_palettes: list[tuple[int, ...]] = []
    shine_attr = curses.A_BOLD | curses.A_REVERSE
    if use_color and curses.has_colors():
        curses.start_color()
        background = curses.COLOR_BLACK
        try:
            curses.use_default_colors()
            background = -1
        except curses.error:
            pass
        curses.init_pair(1, curses.COLOR_CYAN, background)
        curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_GREEN)
        title_attr |= curses.color_pair(1)
        own_attr = curses.color_pair(2)
        for pair, code, foreground in (
            (3, "31", curses.COLOR_RED),
            (4, "33", curses.COLOR_YELLOW),
            (5, "32", curses.COLOR_GREEN),
        ):
            curses.init_pair(pair, foreground, background)
            remaining_attrs[code] = curses.A_BOLD | curses.color_pair(pair)
        remaining_attrs["2"] = curses.A_DIM
        podium_colors = (220, 250, 208) if curses.COLORS >= 256 else (
            curses.COLOR_YELLOW, curses.COLOR_WHITE, curses.COLOR_RED,
        )
        for pair, foreground in enumerate(podium_colors, 6):
            curses.init_pair(pair, foreground, background)
            podium_attrs.append(curses.A_BOLD | curses.color_pair(pair))
        curses.init_pair(9, curses.COLOR_WHITE, background)
        shine_attr = curses.A_BOLD | curses.color_pair(9)
        for rank, colors in enumerate(HERO_COLORS):
            shades = []
            for shade, foreground in enumerate(colors):
                if curses.COLORS >= 256 and curses.COLOR_PAIRS >= 31:
                    pair = 10 + rank * 7 + shade
                    curses.init_pair(pair, foreground, background)
                    attr = curses.color_pair(pair) | (curses.A_BOLD if shade >= 4 else 0)
                else:
                    attr = podium_attrs[rank] & ~curses.A_BOLD
                    if shade <= 1:
                        attr |= curses.A_DIM
                    elif shade >= 4:
                        attr |= curses.A_BOLD
                    if shade == 6:
                        attr = shine_attr
                shades.append(attr)
            hero_palettes.append(tuple(shades))
    state = ViewState(gpu_type=args.gpu)
    loader = SnapshotLoader()
    history_loader = SnapshotLoader(collect_history)
    history = _read_history_cache()
    history_error = ""
    next_history_refresh = history.updated + HISTORY_INTERVAL if history else 0.0
    snapshot: Snapshot | None = None
    updated: float | None = None
    error = ""
    next_refresh = 0.0
    cache_key = None
    panels: list[tuple[list[PanelLine], int]] = []
    while True:
        result = loader.poll()
        if result is not None:
            fresh, error = result
            if fresh is not None:
                snapshot = fresh
                updated = time.time()
                state.gpu_types = _available_gpu_types(snapshot)
                if state.gpu_type not in state.gpu_types:
                    state.gpu_type = state.gpu_types[0]
        history_result = history_loader.poll()
        if history_result is not None:
            fresh_history, history_error = history_result
            if fresh_history is not None:
                history = fresh_history
            next_history_refresh = time.time() + HISTORY_INTERVAL
        if state.view == "history" and time.time() >= next_history_refresh:
            history_loader.request()
            next_history_refresh = time.time() + HISTORY_INTERVAL
        if time.monotonic() >= next_refresh:
            loader.request()
            next_refresh = time.monotonic() + args.interval
        height, width = screen.getmaxyx()
        now = time.time()
        state.animate(time.monotonic(), history is not None)
        key = (id(snapshot), id(history), state.gpu_type, state.view, state.history_page, width,
               int(now), state.memes, history_error, history_loader.running)
        if key != cache_key:
            left_width = max(2, (width - 1) // 2)
            right_width = max(2, width - left_width - 1)
            if state.view == "history":
                panels = [(_history_lines(history, max(2, width), current_user, history_error, history_loader.running,
                                          3 if state.history_page == "rest" else 0), 0)]
            elif state.view == "live":
                panels = [(_ranking_lines(snapshot, max(2, width), current_user)
                           if snapshot else [PanelLine("Loading Slurm jobs…")], 0)]
            elif state.view == "nodes":
                panels = [(_node_lines(snapshot, max(2, width), current_user, now)
                           if snapshot else [PanelLine("Loading Slurm nodes…")], 0)]
            else:
                panels = [
                    _panel_lines(
                        snapshot, states, state.gpu_type, pane_width, current_user, now,
                        max_jobs=args.max_jobs, show_ids=args.show_ids,
                    ) if snapshot else ([PanelLine("Loading Slurm jobs…")], 0)
                    for states, pane_width in ((RUNNING_STATES, left_width), (QUEUED_STATES, right_width))
                ]
            cache_key = key
        page_height = max(1, height - 6)
        counts = [len(lines) for lines, _ in panels]
        state.clamp(counts, page_height)
        _draw_screen(
            screen, state, panels, snapshot, current_user, args.interval,
            updated, error, loader.running, title_attr, own_attr, remaining_attrs, podium_attrs, history, shine_attr,
            history_error, history_loader.running, hero_palettes,
        )
        action = _handle_key(state, screen.getch(), page_height, counts)
        if action == "quit":
            return 0
        if action == "refresh":
            loader.request()
            next_refresh = time.monotonic() + args.interval
            if state.view == "history":
                history_loader.request()
                next_history_refresh = time.time() + HISTORY_INTERVAL


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="sinner-top", description=__doc__)
    parser.add_argument(
        "command", nargs="?", choices=("update",),
        help="update this installed script from GitHub and exit",
    )
    parser.add_argument(
        "-n",
        "--interval",
        type=float,
        default=5.0,
        help="refresh interval in seconds (default: 5)",
    )
    parser.add_argument(
        "--once",
        action="store_true",
        help="print one snapshot and exit (also the default when output is piped)",
    )
    parser.add_argument(
        "-w",
        "--watch",
        action="store_true",
        help="refresh continuously (interactive mode is already the terminal default)",
    )
    parser.add_argument(
        "--max-jobs",
        type=int,
        default=None,
        help="jobs shown per user; 0 shows all (default: all interactively, 5 with --once)",
    )
    parser.add_argument(
        "--gpu",
        type=str.lower,
        metavar="TYPE",
        default="h200",
        help="GPU type to show initially (default: h200; [/]/g cycles all discovered types)",
    )
    parser.add_argument(
        "--show-ids",
        action="store_true",
        help="also show node names and allocated GPU indices",
    )
    parser.add_argument(
        "--color",
        choices=("auto", "always", "never"),
        default="auto",
        help="color mode (default: auto; honors NO_COLOR)",
    )
    return parser


def _self_update() -> int:
    target = Path(__file__).resolve()
    version = urllib.parse.quote(os.environ.get("SINNER_TOP_VERSION") or "main", safe="")
    base = os.environ.get("SINNER_TOP_BASE_URL") or (
        f"https://raw.githubusercontent.com/WeihangGuo/sinner-top/{version}"
    )
    temporary = None
    print("Downloading the latest sinner-top…", flush=True)
    try:
        request = urllib.request.Request(base.rstrip("/") + "/sinner-top", headers={
            "User-Agent": "sinner-top-updater",
            "Cache-Control": "no-cache",
        })
        with urllib.request.urlopen(request, timeout=30) as response:
            payload = response.read(2 * 1024 * 1024 + 1)
        if len(payload) > 2 * 1024 * 1024:
            raise ValueError("download exceeded 2 MiB")
        if not payload.startswith(b"#!/usr/bin/env python3\n") or b"\ndef main(" not in payload:
            raise ValueError("download is not a sinner-top Python script")
        compile(payload, str(target), "exec")
        if payload == target.read_bytes():
            print(f"Already up to date: {target}")
            return 0
        mode = target.stat().st_mode & 0o777
        with tempfile.NamedTemporaryFile(prefix=".sinner-top.", dir=target.parent, delete=False) as output:
            temporary = output.name
            output.write(payload)
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, target)
        print(f"Updated: {target}\nRun sinner-top again to use the new version.")
        return 0
    except (OSError, ValueError, SyntaxError, urllib.error.URLError) as error:
        print(f"sinner-top update: {error}\nThe installed script was kept unchanged.", file=sys.stderr)
        return 1
    finally:
        if temporary:
            try:
                os.unlink(temporary)
            except OSError:
                pass


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    if args.command == "update":
        try:
            return _self_update()
        except KeyboardInterrupt:
            print("\nUpdate interrupted.", file=sys.stderr)
            return 130
    if args.interval <= 0:
        raise SystemExit("--interval must be positive")
    if args.max_jobs is not None and args.max_jobs < 0:
        raise SystemExit("--max-jobs must be zero or positive")
    watch = args.watch and not args.once
    use_color = args.color == "always" or (
        args.color == "auto" and sys.stdout.isatty() and "NO_COLOR" not in os.environ
    )
    first = True
    try:
        current_user = getpass.getuser()
        if sys.stdin.isatty() and sys.stdout.isatty() and not args.once:
            # Use the live tty dimensions, including inside resized tmux panes,
            # rather than any stale dimensions inherited from the parent shell.
            os.environ.pop("LINES", None)
            os.environ.pop("COLUMNS", None)
            return curses.wrapper(_interactive, args, use_color, current_user)
        while True:
            snapshot = collect_snapshot()
            if watch and not first:
                print("\033[H\033[J", end="")
            print(
                render(
                    snapshot,
                    max_jobs=5 if args.max_jobs is None else args.max_jobs,
                    show_ids=args.show_ids,
                    color=use_color,
                    gpu_type=args.gpu,
                    current_user=current_user,
                ),
                flush=True,
            )
            first = False
            if not watch:
                return 0
            time.sleep(args.interval)
    except KeyboardInterrupt:
        return 0
    except (SlurmCommandError, ValueError, curses.error) as error:
        print(f"sinner-top: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
